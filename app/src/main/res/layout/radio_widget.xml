<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
 <ImageView android:id="@+id/widget_logo" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_channel" android:contentDescription="@string/radio" android:scaleType="fitCenter"/>
 <ViewFlipper android:id="@+id/widget_feedback" android:layout_width="match_parent" android:layout_height="match_parent" android:inAnimation="@anim/widget_feedback_in" android:outAnimation="@anim/widget_feedback_out">
  <FrameLayout android:id="@+id/widget_rest" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
   <ImageView android:id="@+id/widget_play" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:padding="6dp" android:src="@drawable/ic_play" android:contentDescription="@string/radio_start" android:background="@drawable/widget_feedback_background"/>
  </FrameLayout>
 </ViewFlipper>
</FrameLayout>
